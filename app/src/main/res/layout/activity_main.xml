<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#667eea">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁️"
            android:textSize="48sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weather Forecast"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get instant weather updates"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

    <!-- Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Enter Your Location"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textColor="#2E3A59" />

        <EditText
            android:id="@+id/editTextLocation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g., New York, London, Tokyo..."
            android:textSize="16sp"
            android:paddingHorizontal="16dp"
            android:background="#F8F9FA"
            android:layout_marginBottom="16dp"
            android:textColorHint="#9E9E9E"
            android:textColor="#333333" />

        <Button
            android:id="@+id/buttonGetWeather"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🌤️ Get Weather"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:elevation="4dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonEnergyCalculation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚡ Energy Source Calculation"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#FF9800"
            android:textColor="#FFFFFF"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Results Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="20dp"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textViewResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌟 Ready to explore the weather?\n\nEnter your desired location above and tap 'Get Weather' to receive detailed weather information including:\n\n• Current temperature and conditions\n• Humidity and wind speed\n• Today's forecast\n• Hourly predictions\n• UV Index and visibility\n• Sunrise and sunset times\n• Wind direction and pressure\n• Cloud coverage percentage\n\nStart your weather journey now!\n\n📱 How to use this app:\n\n1. Type any city name in the input field above\n2. Tap the 'Get Weather' button\n3. View comprehensive weather data\n4. Scroll through all the information\n5. Try different locations!\n\n🌍 Supported locations:\n• Major cities worldwide\n• Small towns and villages\n• Geographic coordinates\n• Airport codes\n• Postal codes\n\n⭐ Features:\n• Real-time weather data\n• Detailed forecasts\n• Multiple weather parameters\n• Easy-to-read format\n• Instant updates\n\n🔄 This content area will be replaced with actual weather data when you search for a location. The weather information will include temperature, humidity, wind conditions, forecasts, and much more detailed information that will definitely require scrolling to view completely.\n\n📊 Weather data includes:\n• Temperature (current, min, max)\n• Weather conditions description\n• Humidity percentage\n• Wind speed and direction\n• Atmospheric pressure\n• Visibility distance\n• UV index rating\n• Cloud coverage\n• Precipitation amount\n• Sunrise/sunset times\n• Moon phase information\n• Hourly forecasts\n• And much more!"
                android:textSize="16sp"
                android:padding="20dp"
                android:background="#FFFFFF"
                android:textColor="#2E3A59"
                android:lineSpacingExtra="4dp"
                android:elevation="2dp" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>